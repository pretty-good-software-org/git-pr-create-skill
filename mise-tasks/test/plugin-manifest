#!/usr/bin/env bash
#MISE description="Verify the Claude plugin manifest is generated by APM"
set -euo pipefail

tmp="$(mktemp -d "${TMPDIR:-/tmp}/apm-plugin-manifest.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT

cp apm.yml "$tmp/apm.yml"
cp -R skills "$tmp/skills"
mkdir "$tmp/.claude-plugin"

(cd "$tmp" && apm pack --force >/dev/null)

cmp -- .claude-plugin/plugin.json "$tmp/.claude-plugin/plugin.json"
echo "APM-generated plugin.json matches the committed manifest"
